# Copy to .env and fill in. Never commit .env: it holds the app key and credentials.
# Values below are safe production defaults; the local .env may differ (APP_DEBUG=true etc.).

APP_NAME=SRAFES
APP_ENV=production
APP_KEY=
# Must be false on the live site: debug pages reveal configuration and data
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi
APP_URL=https://example.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One log file per day, kept for LOG_DAILY_DAYS days
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Live site (cPanel): MySQL. Create the database and user in cPanel > MySQL Databases.
# To move existing data from SQLite: php artisan migrate --database=mysql
# then: php artisan srafes:copy-database sqlite mysql
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Local development may use SQLite instead: DB_CONNECTION=sqlite (database/database.sqlite)

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Requires HTTPS; leave unset only for local http:// development
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Password reset e-mails need a real mailer (log only writes them to the log file)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# Backups (see docs/OPERATIONS.md). BACKUP_COPY_PATH should be off this server/disk.
BACKUP_PATH=
BACKUP_COPY_PATH=
BACKUP_KEEP=14

VITE_APP_NAME="${APP_NAME}"
